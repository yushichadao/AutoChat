# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 运行时状态目录（版本记忆 state.json、方言缓存 dialect.json、上下文 ai-memory.json），留空用 ./data
WX_DATA_DIR=

# ---------------------------------------------------------------------------
# 微信客户端
# ---------------------------------------------------------------------------
# inject = 对运行中的 Weixin.exe 直接注入（需管理员，失败自动回退 proxy）
# proxy  = 把 DLL 复制成 version.dll 放进安装目录，重启微信由系统加载
WX_INJECT_MODE=inject
# 留空自动探测（注册表 + 常见路径）
WX_INSTALL_DIR=
WX_PROCESS_NAME=Weixin.exe
# hook DLL 绝对路径，必须与本机微信版本匹配
WX_DLL_PATH=
# DLL 在微信进程里起的 HTTP 端口
WX_HOOK_PORT=30001
WX_HOOK_HOST=127.0.0.1
# 注入后等待端口就绪的上限(ms)
WX_READY_TIMEOUT_MS=30000
# 读不到版本时手动指定，用于兼容性判断（如 4.1.10.27）
WX_FORCE_VERSION=
# hook 已在运行时不重复注入（联调/测试用）
WX_SKIP_INJECT=0

# ---------------------------------------------------------------------------
# 本机身份（重要）
# ---------------------------------------------------------------------------
# 本机微信的 wxid。用于识别「自己发出去的消息」，
# 否则数据库轮询会把机器人自己的回复当成别人的提问，造成自问自答、刷屏、烧额度。
# 留空时会尝试从 hook 的 /GetSelfProfile 读；读不到就请手工填上。
WX_SELF_ID=
# 判定「这条是不是我自己发的」：
#   sender —— 按本机 wxid 过滤（默认）。适合「手机主号 + 电脑小号」的小号方案。
#   id     —— 按「机器人发过的消息 id」精确过滤。电脑微信必须扫码登录，
#             所以电脑上的号 == 手机上的号；这时群里的提问者就是本机账号，
#             用 sender 会把你的话全丢掉，必须用 id。
WX_SELF_MODE=sender
# 轮询时是否排除自己的消息（需要 WX_SELF_ID 已知才有效）
WX_POLL_EXCLUDE_SELF=1

# ---------------------------------------------------------------------------
# 收消息
# ---------------------------------------------------------------------------
# webhook = 只靠 DLL 回调；poll = 只轮询数据库；auto = 两者都开
WX_RECEIVE_MODE=auto
# 接收 DLL 回调的端口，会写进启动参数 CallBackURL
WX_WEBHOOK_PORT=30002
# 监听地址。默认只绑回环，避免局域网任意设备伪造消息触发 AI 回复。
# 改成 0.0.0.0 必须同时设置 WX_WEBHOOK_TOKEN。
WX_WEBHOOK_BIND=127.0.0.1
# webhook 鉴权 token（请求头 X-AutoChat-Token 或 ?token=）。留空则不校验。
WX_WEBHOOK_TOKEN=
# webhook 静默多少毫秒后自动启用轮询兜底（0 = 关闭）
WX_WEBHOOK_IDLE_FALLBACK_MS=120000
# 轮询 SQL，列名按约定起别名（msgid/wxid/content/createTime/roomid）
# 留空则用下面的 WX_POLL_CHATS 自动生成（推荐：表名、发送者映射、增量水位全自动）
WX_POLL_SQL=
# 要监听的会话（群 wxid / 好友 wxid，逗号分隔）。
# 例：123456@chatroom,wxid_friend_xxx
WX_POLL_CHATS=
# 消息库名（会话分表所在）
WX_POLL_DB=message_0.db
# 每次轮询取最近多少条
WX_POLL_LIMIT=30
WX_POLL_INTERVAL_MS=1200

# 接口路径：一般不用改，网关会自动探测；特殊 DLL 可在这里覆盖
WX_EP_SEND_TEXT=/SendTextMsg
WX_EP_SEND_IMAGE=/SendImgMsg
WX_EP_SEND_FILE=/SendFileMsg
WX_EP_SEND_XML=/ForwardXMLMsg
WX_EP_SELF=/GetSelfProfile
WX_EP_STATUS=/QueryDB/status
WX_EP_QUERY_DB=/QueryDB/execute

# ---------------------------------------------------------------------------
# AI 自动回复
#   腾讯云 TokenHub : https://tokenhub.tencentmaas.com/v1  + 你的 API Key
#   本地网关        : http://127.0.0.1:8787/v1           + 任意占位 key
# ---------------------------------------------------------------------------
AI_ENABLED=0
# 总闸：0 = 立刻停止自动回复（仍接收、仍记日志）。
# 运行中还可以随时用 `autochat pause` / 图形化配置器里的「立即暂停」拉下，
# 写的是 data/paused 哨兵文件 —— 崩了重启也仍然是暂停状态。
AI_MASTER_SWITCH=1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=hy3
AI_TIMEOUT_MS=25000
AI_MAX_TOKENS=600
AI_TEMPERATURE=0.8

# 人设：文件优先于内联文本
AI_PERSONA_FILE=
AI_SYSTEM_PROMPT=

# 上下文：每个会话保留几轮、闲置多久清空、字符预算上限
# 轮数与字符预算同时生效，先到先裁（从最早的开始丢）
AI_CONTEXT_TURNS=8
AI_CONTEXT_TTL_MS=1800000
AI_CONTEXT_MAX_CHARS=6000

# 节奏控制：同会话冷却、每小时上限、同时处理的条数（0 = 不限）
AI_COOLDOWN_MS=3000
AI_MAX_PER_HOUR=120
AI_MAX_CONCURRENT=2

# 群里什么时候回：never | mention | always
AI_GROUP_REPLY=mention
# 群里被 @ 时认可的称呼，逗号分隔。强烈建议填，例如：小助手,机器人
# 填了之后只有 @ 到这些称呼才算被点名，避免被 @ 别人时误触发
AI_GROUP_AT_NAMES=
# 命中就拒绝回复的短语（别回我 / 不用理我 …），逗号分隔；留空用内置默认集合
AI_REJECT_PATTERNS=
# 私聊是否也要求带触发前缀
AI_PRIVATE_REQUIRE_PREFIX=0
# 触发前缀，留空表示不需要（如 "小助手"）
AI_TRIGGER_PREFIX=

# 只回这些会话（逗号分隔 wxid / 群 123@chatroom），留空不限
AI_ALLOW_CHATS=
# 排除这些会话，优先级高于白名单
AI_DENY_CHATS=

# 回复长度与格式
AI_MAX_REPLY_CHARS=900
AI_STRIP_MARKDOWN=1

# ---------------------------------------------------------------------------
# 按会话差异化配置写在 config.json 的 chats 里（见 config.example.json）：
#   "123456@chatroom": { "enabled": true, "groupReply": "always", "personaFile": "./persona-group.txt" }
# 某个群不想让机器人说话，只要 enabled=false。
# ---------------------------------------------------------------------------
