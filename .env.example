# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 运行时状态目录（版本记忆 state.json、方言缓存 dialect.json、上下文 ai-memory.json），留空用 ./data
WX_DATA_DIR=

# ---------------------------------------------------------------------------
# 微信客户端
# ---------------------------------------------------------------------------
# inject = 对运行中的 Weixin.exe 直接注入（需管理员，失败自动回退 proxy）
# proxy  = 把 DLL 复制成 version.dll 放进安装目录，重启微信由系统加载
WX_INJECT_MODE=inject
# 留空自动探测（注册表 + 常见路径）
WX_INSTALL_DIR=
WX_PROCESS_NAME=Weixin.exe
# hook DLL 绝对路径，必须与本机微信版本匹配
WX_DLL_PATH=
# 与本机微信版本对应的安装包（本地 .exe），用于逆版本安装；留空则用官方下载页
WX_INSTALLER_PATH=
# DLL 在微信进程里起的 HTTP 端口
WX_HOOK_PORT=30001
WX_HOOK_HOST=127.0.0.1
# 注入后等待端口就绪的上限(ms)
WX_READY_TIMEOUT_MS=30000
# 读不到版本时手动指定，用于兼容性判断（如 4.1.10.27）
WX_FORCE_VERSION=
# hook 已在运行时不重复注入（联调/测试用）
WX_SKIP_INJECT=0

# ---------------------------------------------------------------------------
# 本机身份（重要）
# ---------------------------------------------------------------------------
# 本机微信的 wxid。用于识别「自己发出去的消息」，
# 否则数据库轮询会把机器人自己的回复当成别人的提问，造成自问自答、刷屏、烧额度。
# 留空时会尝试从 hook 的 /GetSelfProfile 读；读不到就请手工填上。
WX_SELF_ID=
# 判定「这条是不是我自己发的」：
#   sender —— 按本机 wxid 过滤（默认）。适合「手机主号 + 电脑小号」的小号方案。
#   id     —— 按「机器人发过的消息 id」精确过滤。电脑微信必须扫码登录，
#             所以电脑上的号 == 手机上的号；这时群里的提问者就是本机账号，
#             用 sender 会把你的话全丢掉，必须用 id。
WX_SELF_MODE=sender
# 轮询时是否排除自己的消息（需要 WX_SELF_ID 已知才有效）
WX_POLL_EXCLUDE_SELF=1

# ---------------------------------------------------------------------------
# 收消息
# ---------------------------------------------------------------------------
# webhook = 只靠 DLL 回调；poll = 只轮询数据库；auto = 两者都开
WX_RECEIVE_MODE=auto
# 接收 DLL 回调的端口，会写进启动参数 CallBackURL
WX_WEBHOOK_PORT=30002
# 监听地址。默认只绑回环，避免局域网任意设备伪造消息触发 AI 回复。
# 改成 0.0.0.0 必须同时设置 WX_WEBHOOK_TOKEN。
WX_WEBHOOK_BIND=127.0.0.1
# webhook 鉴权 token（请求头 X-AutoChat-Token 或 ?token=）。留空则不校验。
WX_WEBHOOK_TOKEN=
# webhook 静默多少毫秒后自动启用轮询兜底（0 = 关闭）
WX_WEBHOOK_IDLE_FALLBACK_MS=120000
# 轮询 SQL，列名按约定起别名（msgid/wxid/content/createTime/roomid）
# 留空则用下面的 WX_POLL_CHATS 自动生成（推荐：表名、发送者映射、增量水位全自动）
WX_POLL_SQL=
# 要监听的会话（群 wxid / 好友 wxid，逗号分隔）。
# 例：123456@chatroom,wxid_friend_xxx
WX_POLL_CHATS=
# 消息库名（会话分表所在）
WX_POLL_DB=message_0.db
# 每次轮询取最近多少条
WX_POLL_LIMIT=30
WX_POLL_INTERVAL_MS=1200
# 漏接补偿：周期性复检「最近 N 条消息」，补答被自过滤误标/竞态跳过而漏掉的用户消息（默认开）
# 只复检已越过水位的消息，与正常增量处理不重叠，不会重复回复。
WX_RECONCILE_ENABLED=1
WX_RECONCILE_WINDOW=10
WX_RECONCILE_INTERVAL_MS=20000

# 接口路径：一般不用改，网关会自动探测；特殊 DLL 可在这里覆盖
WX_EP_SEND_TEXT=/SendTextMsg
WX_EP_SEND_IMAGE=/SendImgMsg
WX_EP_SEND_FILE=/SendFileMsg
WX_EP_SEND_XML=/ForwardXMLMsg
WX_EP_SELF=/GetSelfProfile
WX_EP_STATUS=/QueryDB/status
WX_EP_QUERY_DB=/QueryDB/execute

# ---------------------------------------------------------------------------
# AI 自动回复
#   腾讯云 TokenHub : https://tokenhub.tencentmaas.com/v1  + 你的 API Key
#   本地网关        : http://127.0.0.1:8787/v1           + 任意占位 key
# ---------------------------------------------------------------------------
AI_ENABLED=0
# 自动回复开关：0 = 只接收消息、不回复、不调用模型（下次启动生效）。
# 运行中想临时停止，用 `autochat pause`（立刻生效，仍接收消息、仍记日志），
# 写的是 data/paused 哨兵文件 —— 崩了重启后也仍然是暂停状态。
# 已废弃：AI_MASTER_SWITCH 的语义在 2.0.0 起并入 AI_ENABLED（旧配置仍会被读取，
# 为 0 同样视为「不自动回复」），体检会提示删掉它。
# AI_MASTER_SWITCH=1

# 本地模型服务（Ollama 等）：autochat model service start 会用这里的命令拉起它
# auto = 自动探测（Ollama）；llamacpp = 用下面的自定义命令；manual = 只提示，不代启
MODEL_SERVICE_RUNNER=auto
# 自定义启动命令（runner=llamacpp/manual 时用），例：C:/tools/llama-server.exe -m model.gguf --port 8000
MODEL_SERVICE_CMD=
# 启动后等多久算就绪（毫秒）
MODEL_SERVICE_READY_TIMEOUT_MS=30000
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=hy3
AI_TIMEOUT_MS=25000
#   ^ 请求超时(ms)，0 = 不限时（本地大模型加载权重可设 0 等它慢慢跑）
AI_MAX_TOKENS=600
#   ^ 单次回复最多多少 token，0 = 不限制（由模型自己决定）
AI_TEMPERATURE=0.8

# 思考强度（推理模型先想多久再回答）：off | low | medium | high
#   off（默认）—— 不带任何思考参数，最省、最快
#   low/medium/high —— 越准但越慢越贵；模型不支持会自动去掉参数重试，不会把助手弄哑
# 命令行：autochat effort high    图形化配置器：「接一个模型」卡 → 高级项 → 思考强度
AI_REASONING_EFFORT=off
# 思考参数格式（各家模型的字段不一样）：
#   auto（默认）—— 自动判断：先看接口地址（openrouter.ai→openrouter、api.anthropic.com→anthropic、
#                 generativelanguage→gemini、dashscope→qwen、api.deepseek.com/open.bigmodel.cn→thinking），
#                 再看模型名（Qwen3/QwQ/ERNIE→qwen、Claude→anthropic、Gemini→gemini、
#                 DeepSeek/GLM/Kimi/混元→thinking、gpt-5/o 系列/Grok→standard、gpt-oss/llama3.x→ollama）；
#                 都认不出来就按标准那套发
#   standard   —— reasoning_effort（OpenAI o 系列 / gpt-5 / Grok / 多数网关）
#   openrouter —— reasoning.effort
#   qwen       —— enable_thinking + thinking_budget
#   anthropic  —— thinking.type + thinking.budget_tokens
#   gemini     —— extra_body.google.thinking_config.thinking_budget
#   thinking   —— thinking.type 开关（只有开/关，低中高档都翻译成「开启」）
#   ollama     —— think=false / "low" / "medium" / "high"
AI_REASONING_FORMAT=auto
# 思考预算 token（按 token 表达强弱的格式生效：qwen/anthropic/gemini/openrouter）：
# 0 = 按档位自动换算（低 1K / 中 4K / 高 8K）
AI_REASONING_BUDGET=0

# 人设：文件优先于内联文本
AI_PERSONA_FILE=
AI_SYSTEM_PROMPT=

# 上下文：每个会话保留几轮、闲置多久清空、字符预算上限
# 轮数与字符预算同时生效，先到先裁（从最早的开始丢）
AI_CONTEXT_TURNS=8
AI_CONTEXT_TTL_MS=1800000
AI_CONTEXT_MAX_CHARS=6000

# 节奏控制：同会话冷却、每小时上限、同时处理的条数（0 = 不限）
AI_COOLDOWN_MS=3000
AI_MAX_PER_HOUR=120
AI_MAX_CONCURRENT=2

# 群里什么时候回：never | mention | always
AI_GROUP_REPLY=mention
# 群里被 @ 时认可的称呼，逗号分隔。强烈建议填，例如：小助手,机器人
# 填了之后只有 @ 到这些称呼才算被点名，避免被 @ 别人时误触发
AI_GROUP_AT_NAMES=
# 命中就拒绝回复的短语（别回我 / 不用理我 …），逗号分隔；留空用内置默认集合
AI_REJECT_PATTERNS=
# 私聊是否也要求带触发前缀
AI_PRIVATE_REQUIRE_PREFIX=0
# 触发前缀，留空表示不需要（如 "小助手"）
AI_TRIGGER_PREFIX=

# 只回这些会话（逗号分隔 wxid / 群 123@chatroom），留空不限
AI_ALLOW_CHATS=
# 排除这些会话，优先级高于白名单
AI_DENY_CHATS=

# 回复长度与格式
AI_MAX_REPLY_CHARS=900
AI_STRIP_MARKDOWN=1

# ---------------------------------------------------------------------------
# 联网搜索与 AI 工具调用（Skills，见计划 §16.2 / §16.4）
#   默认全部关闭，必须显式 opt-in。开启后：查询文本会发往第三方搜索 provider（隐私 / 离线优先原则）。
# ---------------------------------------------------------------------------
# 联网搜索：让 AI 按需检索网页（新闻 / 天气 / 股价 / 实时事实）。
AI_WEB_SEARCH=0
# provider：tavily | serpapi | bing | custom
AI_WEB_SEARCH_PROVIDER=tavily
# 搜索 provider 的密钥（tavily/serpapi/bing 需要；custom 可空）
AI_WEB_SEARCH_KEY=
# 触发模式：always（每条都搜）| auto（时间敏感词 / 显式检索词命中才搜）| prefix（仅 /web 前缀）
AI_WEB_SEARCH_MODE=auto
# prefix 模式下的触发前缀
AI_WEB_SEARCH_TRIGGER=/web
# 结果条数 / 单条字符上限
AI_WEB_SEARCH_MAX_RESULTS=5
AI_WEB_SEARCH_MAX_CHARS=4000
# custom provider 的接口地址（provider=custom 时填）
AI_WEB_SEARCH_CUSTOM_URL=

# AI 工具调用 / Skills 框架（让模型自己决定调工具：联网搜索 / 计算 / 时间 …）
AI_TOOLS=0
# 白名单（逗号分隔技能名）：web_search,calculator,time。留空＝允许全部内置技能。
AI_TOOLS_ALLOW=
# 单轮对话内工具调用最大轮次（防模型陷入无限循环；默认 3，日常够用）
AI_TOOLS_MAX_ROUNDS=3

# 双模型路由（高级模式，§16.5）：默认关闭＝始终用 AI_MODEL 这一个模型（用户设置）。
# 开启后按复杂度在两个「都由你指定」的模型间切换：简单任务走轻量模型，复杂任务走主模型。
# 复杂度用规则判定，不额外调一次模型，因此不增加延迟。
AI_MODEL_ROUTING=0
# 轻量模型（用户指定）；名称留空则回落主模型，不会打到空 endpoint
AI_LIGHT_MODEL=
AI_LIGHT_BASE_URL=
AI_LIGHT_API_KEY=

# 长任务提示（默认开）：联网检索 / 工具调用 / 文档解析 / 写代码长文前，先发一条「正在XX中……」，
# 结果另起一条新消息（微信不支持对已发消息原地替换，故是两条真消息）。
# 长任务本身稀少（需先开了联网 / 工具 / 文档解读），不会打扰日常闲聊；不想发设 0。
AI_LONG_TASK_NOTICE=1

# 文档解读（基础办公，§16.6）：默认关闭。开启后，用户在群里发的附件会被抽取成文本再回答。
# 抽取是**纯本地**的（零依赖解析，不发往任何外部服务），与「联网搜索」是两回事。
# 支持 txt/md/csv/json/log/yml/ini 与 docx/xlsx/pptx/pdf。
AI_DOC_ANALYSIS=0
# 单份文档抽取的字符上限（防长文档撑爆上下文，0＝不限）
AI_DOC_MAX_CHARS=12000
# 生成文档的输出目录（沙箱，write_doc 只能写这里）；留空＝ dataDir/outbox
AI_DOC_OUT_DIR=

# ---------------------------------------------------------------------------
# 多模态（图 → 文 / 文 → 图，见计划 §3.1 / GAP2）
#   入站带图的消息会送「视觉模型」理解；出站若返回图片/文件则走原生消息发送。
#   注意：走云端视觉模型时，图片字节会发送给模型服务商，属外发（见 LEGAL.md）。
# ---------------------------------------------------------------------------
# 视觉模型（OpenAI 兼容、支持 image_url 的模型，如 gpt-4o / gemini 等）。
# 留空 = 回落到上面的 AI_MODEL（多数多模态模型同时支持文本与图片）。
AI_VISION_MODEL=
# 入站图片体积护栏（字节）：超过此大小的图不送模型，防 base64 外发爆 token/费用。
# 0 = 不限制。被拦下的图会跳过并记日志，但不写图字节、不落盘。
AI_MAX_IMAGE_BYTES=8388608
# 长期记忆摘要间隔（轮）：每累计 N 轮对话把转录并入持久摘要库（autochat memory export 可读）。
AI_MEMORY_SUMMARY_INTERVAL=8

# ---------------------------------------------------------------------------
# 按会话差异化配置写在 config.json 的 chats 里（见 config.example.json）：
#   "123456@chatroom": { "enabled": true, "groupReply": "always", "personaFile": "./persona-group.txt" }
# 某个群不想让机器人说话，只要 enabled=false。
# ---------------------------------------------------------------------------
