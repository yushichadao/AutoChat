{
  "name": "autochat",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "description": "AutoChat：微信侧的本地 AI 助手（注入 hook + 本地模型，零运行时依赖）",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Yushichadao <yushichadao@qq.com>",
  "maintainers": [
    "Yushichadao <yushichadao@qq.com>"
  ],
  "keywords": [
    "wechat",
    "bot",
    "ai",
    "llm",
    "automation",
    "openai-compatible",
    "wechat-hook",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yushichadao/AutoChat.git"
  },
  "bugs": {
    "url": "https://github.com/yushichadao/AutoChat/issues"
  },
  "homepage": "https://github.com/yushichadao/AutoChat#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/cli/index.js start",
    "start:bg": "node src/cli/index.js start --background",
    "dev": "node --watch src/cli/index.js start",
    "test": "node --test test/*.test.js",
    "demo": "node tools/demo.js",
    "doctor": "node src/cli/index.js doctor",
    "setup": "node src/cli/index.js setup",
    "gui": "node src/cli/index.js gui",
    "status": "node src/cli/index.js status",
    "logs": "node src/cli/index.js logs",
    "version": "node src/cli/index.js version",
    "model": "node src/cli/index.js model",
    "model-service": "node src/cli/index.js model service",
    "install-service": "node src/cli/index.js install",
    "uninstall-service": "node src/cli/index.js uninstall",
    "pause": "node src/cli/index.js pause",
    "resume": "node src/cli/index.js resume",
    "stop": "node src/cli/index.js stop",
    "dist": "pwsh -ExecutionPolicy Bypass -File tools/build-portable.ps1",
    "mcp": "node src/mcp/server.js"
  },
  "prepublishOnly": "node --test test/*.test.js",
  "bin": {
    "autochat": "src/cli/index.js"
  },
  "dependencies": {},
  "files": [
    "src/",
    "plugin/dsh-autochat/",
    "tools/*.js",
    "tools/*.bat",
    "test/",
    "docs/*.md",
    ".mcp.json",
    ".env.example",
    "config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LEGAL.md",
    "LICENSE"
  ]
}
